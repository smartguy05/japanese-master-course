# =============================================================================
# Nihongo Sensei - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# SECURITY WARNING: Never commit .env to version control
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nihongo_sensei
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Database URL (constructed from above values in docker-compose)
# For local development outside Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/nihongo_sensei

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty for no password in development, set strong password in production

# Redis URL (constructed from above values)
# REDIS_URL=redis://:password@redis:6379/0

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================

# Anthropic Claude API (REQUIRED for conversation features)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI API (REQUIRED for Whisper speech-to-text)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Cloud Text-to-Speech (REQUIRED for Japanese voice synthesis)
# Get your API key from: https://console.cloud.google.com/
GOOGLE_CLOUD_TTS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================

# Conversation Model (Claude)
AI_CONVERSATION_MODEL=claude-sonnet-4-20250514
AI_CONVERSATION_BASE_URL=https://api.anthropic.com

# Speech-to-Text Model (Whisper)
AI_STT_MODEL=whisper-1
AI_STT_BASE_URL=https://api.openai.com

# Text-to-Speech Model (Google Cloud)
AI_TTS_MODEL=ja-JP-Neural2-B
AI_TTS_BASE_URL=https://texttospeech.googleapis.com

# Content Generation Model
CONTENT_GENERATION_MODEL=claude-sonnet-4-20250514

# Enable AI response caching (saves API costs)
ENABLE_CONTENT_CACHING=true

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# SERVICE PORTS
# =============================================================================

# Backend API port
BACKEND_PORT=8000

# Frontend port
FRONTEND_PORT=3000

# Nginx ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Public API URL (accessible from browser)
# Development: http://localhost:8000
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# DATA IMPORT & INITIALIZATION
# =============================================================================

# Import initial Japanese dictionary data on first startup
IMPORT_INITIAL_DATA=false

# =============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# =============================================================================

# Custom AI provider URLs (for self-hosted or alternative providers)
# AI_CONVERSATION_BASE_URL=http://localhost:11434  # Ollama example
# AI_CONVERSATION_MODEL=llama3.1:70b

# Azure OpenAI example
# AI_CONVERSATION_BASE_URL=https://your-resource.openai.azure.com
# AI_CONVERSATION_MODEL=your-deployment-name

# Database pool size (for production scaling)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# Redis connection pool size
# REDIS_POOL_SIZE=10

# Content generation batch size
# CONTENT_BATCH_SIZE=50

# Session timeout (in seconds)
# SESSION_TIMEOUT=3600

# Maximum upload file size (in MB)
# MAX_UPLOAD_SIZE=20

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Enable debug mode (DO NOT USE IN PRODUCTION)
# DEBUG=false

# Enable SQL query logging
# SQL_ECHO=false

# Hot reload for backend
# RELOAD=true
