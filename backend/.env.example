# Application Configuration
APP_NAME="Nihongo Sensei"
APP_VERSION="0.1.0"
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=INSECURE_DEV_KEY_CHANGE_IN_PRODUCTION_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nihongo_sensei
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI Services (Add your API keys here)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_CLOUD_TTS_KEY=your-google-cloud-key-here

# AI Configuration
AI_CONVERSATION_MODEL=claude-sonnet-4-20250514
AI_CONVERSATION_BASE_URL=https://api.anthropic.com
AI_STT_MODEL=whisper-1
AI_STT_BASE_URL=https://api.openai.com
AI_TTS_MODEL=ja-JP-Neural2-B

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Content Generation
CONTENT_GENERATION_MODEL=claude-sonnet-4-20250514
ENABLE_CONTENT_CACHING=true
